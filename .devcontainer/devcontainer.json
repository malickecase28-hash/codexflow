{
  "name": "CodexFlow Rust",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/facebook/devcontainers/features/dotslash:latest": {}
  },
  "containerEnv": {
    "RUST_BACKTRACE": "1",
    "CARGO_INCREMENTAL": "0",
    "CARGO_TARGET_DIR": "/home/ubuntu/.cache/codexflow/cargo-target"
  },
  "postCreateCommand": "bash .devcontainer/bootstrap-rust.sh --prepare",
  "remoteUser": "ubuntu",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "rust-analyzer.cargo.targetDir": true
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
